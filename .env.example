# =============================================================================
# Android Game Starter — Environment Configuration (.env.example)
# Salin file ini menjadi `.env` di root project:
#   cp .env.example .env
#
# Prioritas pembacaan di Gradle (:app):
#   1. OS Environment Variable (System.getenv)
#   2. File `.env` di root project
#   3. File `local.properties`
#   4. Nilai default fallback (aman untuk Mode Demo)
# =============================================================================

# --- 1. Identitas Game & Kebijakan Privasi ---
GAME_ID=sample-puzzle-v1
PRIVACY_POLICY_URL=https://example.com/privacy

# --- 2. Konfigurasi Server Backend Go (HTTP JSON v1) ---
# Gunakan http://10.0.2.2:8080 untuk Android Emulator ke localhost mesin host
BACKEND_BASE_URL=http://10.0.2.2:8080
# Opsional: API key / client token statis (dikirim sebagai header X-API-Key jika diisi)
BACKEND_API_KEY=
BACKEND_TIMEOUT_MS=5000
# Set true jika saldo reward iklan pada mode integrated harus menunggu verifikasi callback server Go
USE_SERVER_REWARD_VERIFICATION=false

# --- 3. Google Sign-In (Android Credential Manager) ---
# OAuth 2.0 Web Client ID dari Google Cloud Console (untuk ditukar ke POST /v1/auth/google)
GOOGLE_WEB_CLIENT_ID=demo-web-client-id.apps.googleusercontent.com

# --- 4. Google Mobile Ads (AdMob) ---
# Default di bawah adalah Official Google Test IDs untuk pengembangan.
# Ganti dengan ID produksi dari dashboard AdMob saat rilis.
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-3940256099942544/6300978111

# --- 5. Google Play Billing (Subscription Remove Ads / Google Pay) ---
BILLING_REMOVE_ADS_SUB_PRODUCT_ID=sub_remove_ads_monthly
BILLING_REMOVE_ADS_BASE_PLAN_ID=monthly-autorenew

# --- 6. Firebase Cloud Messaging (FCM) ---
# Opsional bila tidak menggunakan google-services.json atau untuk inisialisasi manual
FCM_PROJECT_ID=
FCM_APP_ID=
FCM_SENDER_ID=
FCM_API_KEY=
